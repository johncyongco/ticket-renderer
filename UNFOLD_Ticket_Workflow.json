      "typeVersion": 4.6,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://unfold-ticket-renderer:8080/ticket",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({name: $('Prepare ticket').first().json.name, code: $('Prepare ticket').first().json.code}) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "ticket"
            }
          }
        }
      },
      "id": "9a8d537f-359d-48f7-8886-4c3948ca28f6",
