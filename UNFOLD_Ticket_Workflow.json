      "id": "8baad99b-7643-45b5-b166-e1ceea05270e",
      "name": "Read registration rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const { randomBytes } = require('crypto');\nconst nameColumn = 'Full Name';\nconst emailColumn = 'Email Address';\nconst rows = $input.all();\nconst selected = rows.find(({json: row}) =>\n  String(row['Payment Status']).trim().toLowerCase() === 'paid' &&\n  (!String(row['Ticket Status'] ?? '').trim() ||\n    String(row['Ticket Status']).trim().toLowerCase() === 'pending') &&\n  String(row[nameColumn] ?? '').trim() &&\n  /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(row[emailColumn] ?? '').trim())\n);\nif (!selected) return [];\nconst row = selected.json;\nconst rowNumber = Number(row.row_number);\nif (!Number.isInteger(rowNumber) || rowNumber < 2) throw new Error('Missing response row number.');\nconst name = String(row[nameColumn]).trim();\nconst email = String(row[emailColumn]).trim();\nlet code = String(row['Ticket Code'] ?? '').trim();\nif (code && !/^UNF-[A-F0-9]{16}$/.test(code)) throw new Error('Invalid existing ticket code at row ' + rowNumber);\nif (!code) {\n  const existing = new Set(rows.map(({json}) => String(json['Ticket Code'] ?? '').trim()));\n  do { code = 'UNF-' + randomBytes(8).toString('hex').toUpperCase(); } while (existing.has(code));\n}\nconst escapeHtml = (value) => value.replace(/[&<>\"']/g, (char) => ({\n  '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;'\n}[char]));\nconst html = `<div style=\"background:#f3e9d8;padding:28px;font-family:Arial,sans-serif;color:#26221e\">\n<div style=\"max-width:560px;margin:auto;background:#191a18;color:#f3e9d8;padding:28px;border-top:5px solid #9f4433\">\n<p style=\"letter-spacing:2px;color:#e4a28f\">RAISE WORSHIP</p><h1 style=\"font-family:Georgia,serif\">UN/FOLD</h1>\n<p>Hi ${escapeHtml(name)}, your regular admission ticket is attached.</p>\n<p><strong>November 21, 2026 \u00b7 6:00 PM</strong><br>AULGA Sports Gym<br>Lawa-an II, Talisay City, Cebu</p>\n<p>Ticket code<br><strong style=\"font-family:monospace\">${code}</strong></p>\n<p>Show the attached QR ticket or a screenshot at the entrance.</p></div></div>`;\nreturn [{json: {rowNumber, name, email, code, html}}];"
      },
      "id": "1198e449-9fef-4814-b47d-45ba97ca89de",
      "name": "Prepare ticket",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "PASTE_RESPONSE_SPREADSHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Form Responses 1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
