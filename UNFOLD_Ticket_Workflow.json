    {
      "parameters": {
        "jsCode": "const output = $('Render PNG ticket').first().binary.ticket;\nconst details = $('Prepare ticket').first().json;\nreturn [{json: details, binary: {ticket: {...output, fileName: details.code + '.png'}}}];"
      },
