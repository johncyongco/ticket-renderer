              "type": "string",
              "canBeUsedToMatch": false,
              "display": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      },
      "id": "6ea7b747-7775-4b3e-b720-3133f33924b8",
      "name": "Save ticket code",
